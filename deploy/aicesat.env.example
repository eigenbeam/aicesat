# AIcesat public web-app environment (systemd EnvironmentFile). Copy to /opt/aicesat/aicesat.env and fill in.
# This configures the PUBLIC, code-gated beta web app (scripts/serve.py behind Caddy). The owner's private MCP
# process (Claude Desktop over SSH) sets NONE of the gate/public vars, so it stays ungated — see claude-desktop.json.

# The externally-reachable base URL Caddy terminates TLS for. Widget URLs handed to browsers use this, not 127.0.0.1.
# Use your EC2's sslip.io name for instant free TLS (e.g. https://54-201-9-8.sslip.io) or a real domain you point at it.
AICESAT_PUBLIC_URL=https://REPLACE-ME.sslip.io

# Shared access code beta users type on the gate page. Hand this out. Change it to rotate access (restart the service).
AICESAT_ACCESS_CODE=REPLACE-WITH-A-CODE

# Bind + data. serve.py binds 127.0.0.1 only; Caddy is the sole public listener. 8768 is the public app's port.
AICESAT_PORT=8768
AICESAT_DATA_DIR=/opt/aicesat/data

# In-region S3-direct: this is the whole point of us-west-2. Leave as-is on the EC2.
AWS_REGION=us-west-2

# Earthdata token. Prefer the file at /opt/aicesat/.edl/token.prod (scp it up); or paste the bearer token here instead:
# EARTHDATA_TOKEN=eyJ0eXAi...
AICESAT_EDL_FILE=/opt/aicesat/.edl/token.prod
